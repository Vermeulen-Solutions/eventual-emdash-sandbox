# Origin of the EmDash site hosting Eventual's public JSON API.
# Omit this only when this Astro server shares the EmDash origin.
EVENTUAL_API_ORIGIN=http://127.0.0.1:4322

# Rendering defaults used for the current month, translated labels, and week layout.
EVENTUAL_LOCALE=en-GB
EVENTUAL_DISPLAY_TIMEZONE=Europe/Amsterdam
