---
import SiteLayout from "../layouts/SiteLayout.astro";
import EventList from "eventual/astro/EventList.astro";
import { fetchPublicFeed } from "eventual/astro";
import { EVENTUAL_API_ORIGIN, EVENTUAL_LOCALE } from "astro:env/server";

const from = new Date().toISOString().slice(0, 10);
const throughDate = new Date(`${from}T00:00:00Z`);
throughDate.setUTCDate(throughDate.getUTCDate() + 30);
const through = throughDate.toISOString().slice(0, 10);
const apiOrigin = EVENTUAL_API_ORIGIN || Astro.url.origin;
const { events } = await fetchPublicFeed(apiOrigin, from, through);
---

<SiteLayout title="Upcoming events" locale={EVENTUAL_LOCALE} description="Upcoming events list">
  <main class="event-browser" id="main-content" tabindex="-1">
    <h1>Upcoming events</h1>
    <EventList events={events} />
  </main>
</SiteLayout>

