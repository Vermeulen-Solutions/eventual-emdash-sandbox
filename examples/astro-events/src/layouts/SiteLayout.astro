---
import "../styles/global.css";
import { messagesForLocale } from "../lib/messages";

interface Props {
	title: string;
	locale: string;
	description?: string;
}

const { title, locale, description } = Astro.props;
const labels = messagesForLocale(locale);
const metaDescription = description || labels.browseIntro;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={metaDescription} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{labels.skipToContent}</a>
		<slot />
		<footer class="site-footer">Event listings provided by Eventual</footer>
	</body>
</html>
