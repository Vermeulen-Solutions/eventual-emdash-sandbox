---
import type { PublicEvent } from "./feed";
import { eventPageUrl, displayEventDate } from './event-list';

interface Props {
  events: PublicEvent[];
  basePath?: string;
  heading?: string;
  locale?: string;
  emptyMessage?: string;
}

const { events, basePath = "/events", heading, locale = Astro.currentLocale, emptyMessage = 'No events found.' } = Astro.props;

function eventUrl(event: PublicEvent): string {
  return eventPageUrl(event,basePath);
}
---

{heading && <h2>{heading}</h2>}
{events.length === 0 ? <p>{emptyMessage}</p> : (
  <ul>
    {events.map((event) => (
      <li>
        <a href={eventUrl(event)}>{event.title}</a>
        <time datetime={event.start}>{displayEventDate(event,locale ?? event.locale ?? 'en-GB')}</time>
        {(event.venue?.name || event.location) && <span>{event.venue?.name || event.location}</span>}
      </li>
    ))}
  </ul>
)}
