{
	"name": "eventual",
	"version": "0.12.0",
	"license": "MIT",
	"homepage": "https://plugins.emdashcms.com/plugins/@vermeulen.solutions/eventual",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.19.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./schema": "./src/schema/blueprint.ts",
		"./astro": "./astro/feed.ts",
		"./astro/schema": "./astro/schema.ts",
		"./astro/EventList.astro": "./astro/EventList.astro",
		"./transfer": {
			"types": "./transfer/index.d.mts",
			"import": "./transfer/index.mjs"
		}
	},
	"files": [
		"dist/*.mjs",
		"dist/*.d.mts",
		"emdash-plugin.jsonc",
		"astro",
		"transfer",
		"src/domain",
		"src/schema",
		"src/storage.ts",
		"src/public-event.ts",
		"docs/native-modernization.md",
		"scripts/export-native-schema.mjs"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup",
		"budget": "node scripts/bundle-budget.mjs",
		"test:tooling": "node --test scripts/*.test.mjs",
		"test:package": "node scripts/verify-packed-astro.mjs",
		"profile": "vitest run --config vitest.profile.config.ts"
	},
	"peerDependencies": {
		"emdash": ">=1.0.1"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.1",
		"@emdash-cms/plugin-test": "0.2.6",
		"emdash": "1.0.1",
		"ical.js": "^2.2.1",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"@emdash-cms/blocks": "1.0.1",
		"zod": "4.5.4"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	}
}
