{
  "name": "@vermeulen.solutions/eventual",
  "version": "0.18.1",
  "license": "MIT",
  "homepage": "https://plugins.emdashcms.com/plugins/@vermeulen.solutions/eventual",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./sandbox": "./dist/plugin.mjs",
    "./schema": {
      "types": "./astro/blueprint.d.mts",
      "import": "./astro/blueprint.mjs"
    },
    "./astro": "./astro/feed.ts",
    "./astro/schema": "./astro/schema.ts",
    "./astro/EventList.astro": "./astro/EventList.astro",
    "./transfer": {
      "types": "./transfer/index.d.mts",
      "import": "./transfer/index.mjs"
    },
    "./admin": {
      "types": "./astro/admin.d.mts",
      "import": "./astro/admin.mjs"
    },
    "./admin/compat": "./astro/editor-compat.mjs",
    "./admin/i18n": "./astro/editor-i18n.mjs",
    "./install": {
      "types": "./astro/install.d.mts",
      "import": "./astro/install.mjs"
    }
  },
  "files": [
    "dist/*.mjs",
    "dist/*.d.mts",
    "emdash-plugin.jsonc",
    "astro",
    "transfer",
    "src/domain",
    "src/schema",
    "src/storage.ts",
    "src/public-event.ts",
    "docs/native-modernization.md",
    "docs/registry-installation.md",
    "scripts/export-native-schema.mjs",
    "scripts/upgrade-native-editor.mjs",
    "scripts/check-editor-installation.mjs",
    "docs/collection-setup.md",
    "docs/upgrade-0.13.0.md",
    "docs/user-guide.md",
    "docs/history.md",
    "docs/release-notes-0.14.0.md",
    "docs/release-notes-0.14.1.md",
    "docs/public-feed-caching.md",
    "docs/release-notes-0.15.0.md",
    "docs/release-notes-0.16.0.md",
    "docs/release-notes-0.17.0.md",
    "docs/release-notes-0.18.0.md",
    "docs/release-notes-0.18.1.md"
  ],
  "scripts": {
    "validate": "emdash-plugin validate",
    "build": "npm run i18n:pack && emdash-plugin build && node scripts/build-host.mjs",
    "prepack": "node scripts/build-host.mjs",
    "dev": "emdash-plugin dev",
    "typecheck": "tsc --noEmit",
    "test": "emdash-plugin validate && vitest run",
    "bundle": "emdash-plugin bundle",
    "login": "emdash-plugin login",
    "publish": "emdash-plugin publish",
    "release:setup": "emdash-plugin release setup",
    "budget": "node scripts/bundle-budget.mjs",
    "registry:media": "node scripts/check-registry-media.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:package": "node scripts/verify-packed-astro.mjs",
    "test:cache": "node scripts/verify-public-cache.mjs",
    "test:editor": "node scripts/verify-editor-host.mjs",
    "profile": "vitest run --config vitest.profile.config.ts",
    "release:prepare": "node scripts/prepare-release.mjs",
    "i18n:pack": "node node_modules/@vermeulen.solutions/eventual-locales/scripts/pack-manifest.mjs core src/ui/locales"
  },
  "peerDependencies": {
    "@emdash-cms/admin": ">=1.2.0 <2.0.0",
    "astro": ">=7.3.2 <8.0.0",
    "emdash": ">=1.2.0 <2.0.0",
    "kysely": "^0.29.0",
    "react": "^19.0.0",
    "vite": ">=8.3.0 <9.0.0"
  },
  "devDependencies": {
    "@emdash-cms/admin": "1.4.0",
    "@emdash-cms/plugin-cli": "0.13.5",
    "@emdash-cms/plugin-test": "0.2.11",
    "@playwright/test": "1.64.1",
    "emdash": "1.4.0",
    "ical.js": "^2.2.1",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@emdash-cms/blocks": "1.4.0",
    "@lingui/core": "5.9.5",
    "zod": "4.5.4",
    "@vermeulen.solutions/eventual-locales": "0.1.10"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@emdash-cms/admin": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici@7.29.0": "7.29.1"
  },
  "description": "Native event collections for EmDash: Portable Text, localization, recurrence, saved venues and multilingual iCalendar feeds.",
  "bin": {
    "eventual-schema": "scripts/export-native-schema.mjs"
  }
}
