{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "eventual",
	"publisher": "did:plc:g2hei4vcwndrdl3gdbb6np6c", // vermeulen.solutions

	"license": "MIT",
	"author": { "name": "Jaap Vermeulen", "email": "jaap.vermeulen@gmail.com" },
	"security": { "email": "jaap.vermeulen@gmail.com" },
	"name": "Eventual",
	"description": "Manage events, venues, and public feeds in EmDash with MCP tools and an Astro example offering seven visitor views.",
	"keywords": ["events", "calendar", "event management", "iCalendar", "venues"],
	"sections": {
		"installation": { "file": "./docs/registry-installation.md" }
	},
	"repo": "https://github.com/Vermeulen-Solutions/eventual-emdash-sandbox",
	"release": {
		"requires": { "env:emdash": ">=1.0.1" },
		"artifacts": {
			"screenshots": [
				{ "file": "./images/registry-0.10.0/01-events-admin.png" },
				{ "file": "./images/registry-0.10.0/02-event-editor.png" },
				{ "file": "./images/registry-0.10.0/03-event-settings.png" },
				{ "file": "./images/registry-0.10.0/04-public-events.png" }
			]
		}
	},

	// Trust contract — what runtime APIs the plugin asks for.
	// Empty arrays mean no extra privileges beyond logging,
	// KV, and route/hook registration. Changing these between
	// releases requires a version bump because installed
	// users have consented to the old contract.
	"capabilities": ["media:read", "media:bytes:read"],
	"allowedHosts": [],
	"storage": {
		"events": { "indexes": ["start", "published", ["published", "start"], "venueId"] },
		"venues": { "indexes": ["name"] },
		"calendar_cancellations": { "indexes": ["eventId", "cancelledAt"] }
	},
	"admin": {
		"widgets": [
			{ "id": "upcoming-events", "title": "Upcoming events", "size": "half" }
		],
		"pages": [
			{ "path": "/events", "label": "Events", "icon": "calendar" },
			{ "path": "/venues", "label": "Venues", "icon": "map-pin" },
			{ "path": "/settings", "label": "Settings", "icon": "settings" }
		],
		"settingsSchema": {
			"defaultTimezone": {
				"label": "Default timezone for new events",
				"description": "IANA timezone used to initialize new events. Each event can use its own timezone.",
				"type": "string",
				"default": "UTC"
			},
			"timeFormat": {
				"label": "Admin time display",
				"description": "12-hour or 24-hour formatting for Eventual's EmDash admin displays.",
				"type": "select",
				"options": [
					{ "value": "24-hour", "label": "24-hour (18:30)" },
					{ "value": "12-hour", "label": "12-hour (6:30 PM)" }
				],
				"default": "24-hour"
			}
		}
	}
}
