{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "eventual",
	"publisher": "did:plc:g2hei4vcwndrdl3gdbb6np6c", // vermeulen.solutions

	"license": "MIT",
	"author": { "name": "Jaap Vermeulen", "email": "jaap.vermeulen@gmail.com" },
	"security": { "email": "jaap.vermeulen@gmail.com" },
	"name": "Eventual",
	"description": "Native multilingual event collections with recurrence validation, iCalendar feeds, Astro helpers and resumable legacy migration.",
	"keywords": ["events", "calendar", "event management", "iCalendar", "venues"],
	"sections": {
		"installation": { "file": "./docs/registry-installation.md" },
		"changelog": { "file": "./docs/registry-changelog.md" }
	},
	"repo": "https://github.com/Vermeulen-Solutions/eventual-emdash-sandbox",
	"release": {
		"requires": { "env:emdash": ">=1.0.1" },
		"artifacts": {
			"icon": { "file": "./images/registry/icon-v1.png" },
			"banner": { "file": "./images/registry/banner-v1.png" },
			"screenshots": [
				{ "file": "./images/registry-0.11.0/05-public-events.jpg" },
				{ "file": "./images/registry-0.11.0/06-hybrid-event-detail.jpg" }
			]
		}
	},

	// Trust contract — what runtime APIs the plugin asks for.
	// Empty arrays mean no extra privileges beyond logging,
	// KV, and route/hook registration. Changing these between
	// releases requires a version bump because installed
	// users have consented to the old contract.
	"capabilities": ["media:read", "media:bytes:read", "content:read", "content:write", "content:publish", "content:revisions:read", "schema:read", "hooks.content-policy:register"],
	"allowedHosts": [],
	"storage": {
		"events": { "indexes": ["start", "published", ["published", "start"], "venueId", "organizerId"] },
		"venues": { "indexes": ["name"] },
		"organizers": { "indexes": ["name"] },
		"calendar_cancellations": { "indexes": ["eventId", "cancelledAt"] }
	},
	"admin": {
		"widgets": [
			{ "id": "upcoming-events", "title": "Upcoming events", "size": "half" }
		],
		"pages": [
			{ "path": "/events", "label": "Eventual", "icon": "calendar" }
		],
		"settingsSchema": {
			"defaultTimezone": {
				"label": "Legacy MCP default timezone",
				"description": "Used by legacy MCP event creation. Native collections use the timezone field's schema default.",
				"type": "string",
				"default": "UTC"
			},
			"timeFormat": {
				"label": "Legacy time display",
				"description": "Retained for legacy settings compatibility. Native editing and Astro rendering use their own locale settings.",
				"type": "select",
				"options": [
					{ "value": "24-hour", "label": "24-hour (18:30)" },
					{ "value": "12-hour", "label": "12-hour (6:30 PM)" }
				],
				"default": "24-hour"
			}
		}
	}
}
